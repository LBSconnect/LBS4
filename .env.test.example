# Copy this file to .env.test and fill in your values.
# .env.test is gitignored — never commit real secrets.

# App base URL (default: http://localhost:5000)
BASE_URL=http://localhost:5000

# Postgres connection string — use a dedicated TEST database, not production
DATABASE_URL=postgresql://user:password@localhost:5432/lbs_test

# Stripe TEST mode keys (get from https://dashboard.stripe.com/test/apikeys)
# Use a placeholder here — never commit a real key, even a test-mode one.
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here

# Webhook signing secret — run: stripe listen --print-secret
# Paste the output into your local, gitignored .env.test — never into this
# example file.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# ─────────────────────────────────────────────────────────────────────────
# Required only for the I-9 / New-Hire Verification portal test suite
# (tests/unit/i9-security.test.ts, tests/unit/i9-status-transitions.test.ts,
# tests/e2e/i9-workflow.spec.ts, tests/e2e/i9-portal-ui.spec.ts). Those e2e
# specs skip themselves automatically when these aren't set — uncomment and
# fill in only if you're running the I-9 suite.
# ─────────────────────────────────────────────────────────────────────────

# 32-byte AES-256 key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# See server/i9Security.ts — required before the portal will accept any
# protected employee data (SSNs, document numbers); gated behind a 503
# "Secure portal configuration required" response when unset.
#PROTECTED_DATA_ENCRYPTION_KEY=

# Signs the I-9 portal's session cookie (server/i9Auth.ts) and password-reset/
# document-download tokens (server/i9Security.ts). Falls back to ADMIN_SECRET,
# then to an insecure dev-only default (with a loud console warning) if unset
# — set explicitly for anything beyond local development.
#SESSION_SECRET=

# One-time bootstrap secret for creating the first I-9 Program Administrator
# account (POST /api/i9/auth/bootstrap-admin in server/i9Routes.ts). Pick any
# high-entropy value for testing.
#I9_ADMIN_BOOTSTRAP_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# Optional — only needed to exercise specific integrations. Every one of
# these is gated: the app logs a warning and disables the related feature
# (rather than crashing) when left unset. See server/stripeClient.ts,
# server/smtpClient.ts, server/corporateRoutes.ts, server/i9Routes.ts.
# ─────────────────────────────────────────────────────────────────────────

# Stripe publishable key (client-side checkout; safe to expose to the browser)
#STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs for the Corporate Notary Division's plan tiers
# (server/corporateRoutes.ts)
#STRIPE_CORPORATE_BRONZE_PRICE_ID=price_...
#STRIPE_CORPORATE_SILVER_PRICE_ID=price_...
#STRIPE_CORPORATE_GOLD_PRICE_ID=price_...

# Shared admin secret for the Corporate Notary Division admin dashboard and
# customer portal login (server/corporateRoutes.ts — POST
# /api/admin/corporate/login, /api/corporate/portal/login). Required
# (no insecure default) — those routes return 503 until this is set.
#ADMIN_SECRET=
# Separate secret for signing the JWTs those logins issue. Falls back to
# ADMIN_SECRET if unset.
#JWT_SECRET=

# Public URL used to build links in outgoing emails (password reset, Stripe
# checkout success/cancel redirects). Defaults to https://www.lbs4.com.
#PUBLIC_SITE_URL=http://localhost:5000

# reCAPTCHA server-side secret (server/routes.ts, server/i9Routes.ts). When
# unset, the affected forms accept submissions without a captcha check.
#RECAPTCHA_SECRET_KEY=

# ── Outbound email — Microsoft Graph API (preferred) ──────────────────────
# server/smtpClient.ts tries Graph first, then falls back to SMTP below.
#AZURE_TENANT_ID=
#AZURE_CLIENT_ID=
#AZURE_CLIENT_SECRET=

# ── Outbound email — SMTP fallback (Gmail, Outlook, Office 365, etc.) ─────
#SMTP_HOST=
#SMTP_USER=
#SMTP_PASS=
#SMTP_PORT=587
#SMTP_FROM_NAME=LBS Test & Exam Center

# "From" address used by both the Graph and SMTP send paths, and the
# Outlook calendar-invite integration. Falls back to SMTP_USER if unset.
#MAIL_FROM_ADDRESS=

# Internal recipient for contact-form/appointment/privacy-request/payment
# notifications (server/emailService.ts, server/routes.ts).
#NOTIFICATION_EMAIL=

# Internal recipient for corporate account admin notifications
# (server/corporateEmailService.ts). Falls back to NOTIFICATION_EMAIL.
#ADMIN_EMAIL=
